import destinos.*
import paquete.*
import mensajeros.*
import celular.*
import vehiculos.*
import empresa.*

describe "Tests de mensajeros" {
  test "Roberto puede llevar un paquete que está pago en un camión que tiene un acoplado" {
    roberto.cambiarVehiculo(camion)
    camion.cambiarAcoplados(1)
    paquete.cambiarDestino(puenteDeBrooklyn)
    paquete.pagar()
    assert.that(paquete.puedeSerEntregado(roberto))
  }
  test "Neo con crédito no puede llevar un paquete que no está pago a la matrix" {
    celular.comprarCredito()
    paquete.cambiarDestino(matrix)
    paquete.cancelarPago()
    assert.notThat(paquete.puedeSerEntregado(neo))
  }
  test "Roberto con un camion con 10 acoplados no puede entrar al puente" {
    roberto.cambiarVehiculo(camion)
    camion.cambiarAcoplados(10)
    assert.notThat(puenteDeBrooklyn.puedeEntrar(roberto))
  }
  test "Chuck Norris puede entregar un paquete que está pago a la matrix" {
    paquete.cambiarDestino(matrix)
    paquete.pagar()
    assert.that(paquete.puedeSerEntregado(chuckNorris))
  }
  test "Neo sin crédito no puede llevar un paquete que está pago a la matrix" {
    celular.seQuedaSinCredito()
    paquete.cambiarDestino(matrix)
    paquete.pagar()
    assert.notThat(paquete.puedeSerEntregado(neo))
  }
}

describe "Tests de la empresa de mensajeria" {
  test "Chuck Norris es contratado en la empresa de mensajeria" {
    empresaDeMensajeria.contratar(chuckNorris)
    assert.that(empresaDeMensajeria.contieneMensajero(chuckNorris))
  }
  test "Al poco tiempo de ser contratado, Chuck Norris es despedido de la empresa" {
    empresaDeMensajeria.contratar(chuckNorris)
    empresaDeMensajeria.despedir(chuckNorris)
    assert.notThat(empresaDeMensajeria.contieneMensajero(chuckNorris))
  }
  test "Todos los mensajeros de la empresa son despedidos" {
    empresaDeMensajeria.contratar(chuckNorris)
    empresaDeMensajeria.contratar(roberto)
    empresaDeMensajeria.despedirATodos()
    assert.that(empresaDeMensajeria.noTieneEmpleados())
  }
  test "Ahora hay 3 empleados en la empresa, por lo que es una empresa grande" {
    empresaDeMensajeria.contratar(chuckNorris)
    empresaDeMensajeria.contratar(roberto)
    empresaDeMensajeria.contratar(neo)
    assert.that(empresaDeMensajeria.esGrande())
  }
  test "Chuck Norris es el primer empleado de la empresa, por lo que puede entregar el paquete a la matrix" {
    empresaDeMensajeria.contratar(chuckNorris)
    empresaDeMensajeria.contratar(roberto)
    empresaDeMensajeria.contratar(neo)
    paquete.cambiarDestino(matrix)
    paquete.pagar()
    assert.that(empresaDeMensajeria.puedeSerEntregadoPorElPrimerEmpleado(paquete))
  }
  test "Neo es el último empleado de la empresa, por lo que su peso es 0" {
    empresaDeMensajeria.contratar(chuckNorris)
    empresaDeMensajeria.contratar(roberto)
    empresaDeMensajeria.contratar(neo)
    assert.that(empresaDeMensajeria.pesoDelUltimoEmpleado() == 0)
  }
}